# Maintainer: OpenRTMP <info@openrtmp.org>
pkgname=librtmp2
pkgver=0.3.0
pkgrel=0
pkgdesc="RTMP/RTMPS protocol library"
url="https://github.com/OpenRTMP/librtmp2"
arch="all"
license="MIT"
depends=""
makedepends="cargo openssl-dev pkgconf"
subpackages="$pkgname-dev"
source=""
builddir="$startdir/.."
options="!check"

# librtmp2 vendors its crates.io dependencies into vendor/ before the build
# (see .github/workflows/publish-apk.yml) because the abuild builders run
# offline. .cargo/config.toml (also generated by the workflow) points cargo
# at that vendor directory.
export CARGO_HOME="$srcdir/cargo_home"
export CARGO_NET_OFFLINE=true

# Per docs/abi-policy.md the soname only bumps on a major (ABI-breaking)
# release, not expected before 1.0.0 - so the soname major tracks "0" for
# the whole 0.x series.
_soname_major=0
_soname="liblibrtmp2.so.$_soname_major"

build() {
	RUSTFLAGS="-C link-arg=-Wl,-soname,$_soname" \
		cargo build --release --offline --all-features --verbose
}

package() {
	install -D -m755 target/release/liblibrtmp2.so \
		"$pkgdir"/usr/lib/liblibrtmp2.so."$pkgver"
	ln -s liblibrtmp2.so."$pkgver" "$pkgdir"/usr/lib/"$_soname"

	install -D -m644 target/release/liblibrtmp2.a \
		"$pkgdir"/usr/lib/liblibrtmp2.a
	ln -s "$_soname" "$pkgdir"/usr/lib/liblibrtmp2.so

	sed -e "s/@VERSION@/$pkgver/" \
		-e 's#/usr/lib/@MULTIARCH@#/usr/lib#' \
		debian/librtmp2.pc.in > "$srcdir"/librtmp2.pc
	install -D -m644 "$srcdir"/librtmp2.pc \
		"$pkgdir"/usr/lib/pkgconfig/librtmp2.pc
}

dev() {
	default_dev
}
